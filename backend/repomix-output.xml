    """Validate symbol: alphanumeric + max 20 chars."""
    return bool(re.match(r'^[A-Z0-9]{1,20}$', symbol))

def validate_timeframe(timeframe: str) -> bool:
    """Validate timeframe against whitelist."""
    return timeframe in MT5_TIMEFRAMES

