    advice: str
    breakeven_win_rate: float

class RiskAnalysisResponse(BaseModel):
    """Response for advisor:risk_analysis event."""
    success: bool = True
    symbol: Optional[str] = None
    risk_profile: str
    risk_reward: Dict[str, Any]
    position_sizing: Dict[str, Any]
