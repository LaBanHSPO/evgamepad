        tracker.track(
            "old",
            DataSource.MT5,
            DataType.PRICE,
            2634.50,
            fetched_at=old_time
        )

        summary = tracker.to_summary()
        assert summary["oldest_data_age_seconds"] > 590  # ~10 minutes

    def test_complex_value_serialization(self, tracker):
        """Test serialization of complex values."""
