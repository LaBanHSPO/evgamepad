  time: string;
  pair: string;
  type: 'BUY' | 'SELL';
  size: string;
  result: 'WIN' | 'LOSS';
  pnl: string;
}

const trades: Trade[] = [
  { id: 'T-0847', time: '14:32:18', pair: 'XAU/USD', type: 'BUY', size: '0.15', result: 'WIN', pnl: '+$234.50' },
  { id: 'T-0846', time: '13:15:42', pair: 'XAU/USD', type: 'BUY', size: '2.40', result: 'WIN', pnl: '+$156.20' },
];

