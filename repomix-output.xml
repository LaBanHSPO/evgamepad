        """Test detection of fake volume pump (broker >> market)."""
        validator = VolumeValidator(api_key="test_key")

        # MT5 broker volume is 3x market volume
        mt5_df = pd.DataFrame({
            'time': pd.date_range('2025-01-01', periods=10, freq='H'),
