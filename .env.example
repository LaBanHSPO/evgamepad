# Copy to .env. Never commit it, never bake it into an image, never include it
# in a backup archive.
#
# There is no auth helper in v1. These come from the manual consent flow in
# README.md -> "cTrader credentials". The gateway only refreshes what you paste
# here, and boot-fails with a pointer to the README if anything is missing.

# --- cTrader Open API (IC Markets DEMO account) ---
CT_CLIENT_ID=
CT_CLIENT_SECRET=
CT_ACCESS_TOKEN=
CT_REFRESH_TOKEN=
CT_ACCOUNT_ID=

# --- Gateway ---
# Shared secret the HUD sends in `hello`. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EV_WS_TOKEN=

# --- AI desk (phase 4) ---
XAI_API_KEY=

# --- TradingView webhook (phase 4, advisory only) ---
TV_WEBHOOK_SECRET=
