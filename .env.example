# Copy to .env and fill in. Never commit .env — it holds a trading-scoped token.
# Walkthrough: README.md → "cTrader Open API registration".

# cTrader Open API (IC Markets demo account). All five are required to boot.
CT_CLIENT_ID=
CT_CLIENT_SECRET=
CT_ACCESS_TOKEN=
CT_REFRESH_TOKEN=
CT_ACCOUNT_ID=

# Shared secret the HUD presents when opening the game socket. Required to boot.
# Generate with: openssl rand -hex 32
EV_WS_TOKEN=

# Optional. Missing key = the desk says "coach offline"; sentinel and trading still run.
XAI_API_KEY=

# Optional. Required only when tradingview.enabled is true.
TV_WEBHOOK_SECRET=

# Browser Origin of the React HUD (CORS + WebSocket Origin allowlist).
# This is the page Chrome loads, NOT the gateway hostname.
# Local Vite:     http://localhost:5173
# Vercel Hobby:   https://your-project.vercel.app
# Custom HUD:     https://bobvolman.com
EV_PUBLIC_ORIGIN=https://YOUR_HUD_ORIGIN
# Optional extra HUD origins, comma-separated (www, Vercel preview URLs, …).
# EV_CORS_ORIGINS=https://www.YOUR_HUD_ORIGIN,https://your-project-git-main.vercel.app

# Deploy knobs. compose.yaml sets EV_LISTEN / EV_CONTAINER_BIND / EV_CONFIG.
# EV_LISTEN=0.0.0.0:8444
# EV_CONTAINER_BIND=1
# EV_CONFIG=/app/config/default.yaml
