# Copy to `.env.local` (gitignored) only if you need to override the default.
#
# Development (`npm run dev`): leave unset. Vite proxies `/api` and `/ws` to 127.0.0.1:8444.
# Production (`npm run build` on your laptop): `app/.env.production` sets
#   VITE_GATEWAY_ORIGIN=https://gw.bobvolman.com
# Vercel Hobby: set the same name as a Production environment variable
#   (Vercel → Project → Settings → Environment Variables). Do not put CT_* there.
#
# VITE_GATEWAY_ORIGIN=https://gw.bobvolman.com
