{
  "channels": [
    "quotes",
    "orders",
    "session",
    "ai",
    "voice"
  ],
  "envelope": {
    "additionalProperties": false,
    "description": "The only frame shape on the wire.\n\n`cid` is the client's idempotency key: the same `cid` replayed after a reconnect must not\nplace a second order. `seq` is per-connection and monotonic, so `hello`/`lastSeq` can resync.",
    "properties": {
      "ch": {
        "description": "Channel this message rides",
        "enum": [
          "quotes",
          "orders",
          "session",
          "ai",
          "voice"
        ],
        "title": "Ch",
        "type": "string"
      },
      "cid": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "ULID idempotency key",
        "title": "Cid"
      },
      "p": {
        "additionalProperties": true,
        "description": "Message payload",
        "title": "P",
        "type": "object"
      },
      "seq": {
        "description": "Per-connection monotonic sequence",
        "minimum": 0,
        "title": "Seq",
        "type": "integer"
      },
      "t": {
        "description": "Message type, e.g. `intent.open`",
        "title": "T",
        "type": "string"
      },
      "ts": {
        "description": "Unix milliseconds at send",
        "minimum": 0,
        "title": "Ts",
        "type": "integer"
      },
      "v": {
        "default": 1,
        "description": "Protocol version",
        "title": "V",
        "type": "integer"
      }
    },
    "required": [
      "t",
      "seq",
      "ts",
      "ch"
    ],
    "title": "Envelope",
    "type": "object"
  },
  "maxFrameBytes": 65536,
  "messages": {
